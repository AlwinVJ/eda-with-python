# Environment Configuration for EDA With Python Docs
# Copy this file to .env.local to customize for local development.

# Base path for deployment.
# Default is '/' for root domains and local development.
# For GitHub Pages project sites (https://<user>.github.io/<repo>/), set to /<repo>/.
# Example: VITE_BASE_PATH=/eda-with-python/
VITE_BASE_PATH=/

# GitHub repository URL (used to generate repository and source code links).
VITE_REPO_URL=https://github.com/AlwinVJ/eda-with-python

# Production site URL (optional, for canonical URLs).
VITE_SITE_URL=https://alwinvj.github.io/eda-with-python

# OneTag AI Integration Key
# Free public client key from https://onetagai.com/#get-key
# Defaults to "PASTE_MY_ONETAG_KEY_HERE" if omitted.
VITE_ONETAG_KEY=PASTE_MY_ONETAG_KEY_HERE
