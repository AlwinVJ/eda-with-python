# Copy this file to .env.local and fill in your real values.
# Next.js loads .env.local automatically for both `next dev` and `next build`.

# Used by lib/content.ts to build GitHub links (source code, raw file downloads).
# Points at the REPO, not the deployed site.
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/EDA-With-Python

# Used by app/sitemap.ts and app/robots.ts to generate absolute URLs.
# Points at the DEPLOYED SITE (e.g. GitHub Pages), not the repo.
NEXT_PUBLIC_SITE_URL=https://your-username.github.io/EDA-With-Python

# Must match your repository name exactly when deploying to GitHub Pages as
# a project site (https://<user>.github.io/<repo>). Leave empty if deploying
# as a user/org root page or a custom domain.
NEXT_PUBLIC_GH_PAGES_REPO_NAME=EDA-With-Python
